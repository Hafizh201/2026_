/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="pemilih" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="44"/><column index="2" value="63"/><column index="3" value="44"/><column index="4" value="61"/><column index="5" value="58"/><column index="6" value="155"/><column index="7" value="112"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- 1. Tabel Kandidat (Lokal)
CREATE TABLE IF NOT EXISTS kandidat (
    id TEXT PRIMARY KEY,
    nomor_paslon INTEGER NOT NULL UNIQUE,
    caketos TEXT NOT NULL,
    cawaketos TEXT NOT NULL,
    path_photo TEXT NOT NULL,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- 2. Tabel Kuota Token (Akses Login)
CREATE TABLE IF NOT EXISTS token_akses (
    token TEXT PRIMARY KEY,          -- Misal: 'X7K9P2'
    sudah_memilih BOOLEAN DEFAULT 0  -- 0 = Belum dipake, 1 = Hangus
);

-- 3. Tabel Antrean Suara (Merekam pilihan sebelum sync)
CREATE TABLE IF NOT EXISTS suara (
    id TEXT PRIMARY KEY,             -- UUID acak
    token TEXT NOT NULL UNIQUE,      
    nomor_paslon INTEGER NOT NULL,
    waktu_coblos DATETIME DEFAULT CURRENT_TIMESTAMP,
    is_synced BOOLEAN DEFAULT 0,
    FOREIGN KEY (token) REFERENCES token_akses(token),
    FOREIGN KEY (nomor_paslon) REFERENCES kandidat(nomor_paslon)
);

-- 4. Tabel Log Error (Memantau kegagalan sync)
CREATE TABLE IF NOT EXISTS log_sync (
    id TEXT PRIMARY KEY,
    suara_id TEXT NOT NULL,
    status TEXT NOT NULL,            -- 'FAILED', 'SUCCESS'
    pesan_error TEXT,
    waktu_sync DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (suara_id) REFERENCES suara(id)
);</sql><current_tab id="0"/></tab_sql></sqlb_project>
